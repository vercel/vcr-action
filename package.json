{
  "name": "vcr-action",
  "description": "GitHub Actions for Vercel Container Registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/login/main.ts src/login/post.ts --bundle --platform=node --target=node20 --format=cjs --outdir=login/dist --out-extension:.js=.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vcr-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "undici": ">=6.28.0"
    }
  }
}
