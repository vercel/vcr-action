{
  "name": "vcr-login-action",
  "description": "GitHub Action to log in to the Vercel Container Registry with Docker, Podman, and Buildah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/post.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vcr-login-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@10.30.2"
}
