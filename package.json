{
  "name": "vcr-action",
  "description": "GitHub Actions for Vercel Container Registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:login && pnpm build:wait-for-optimized-image",
    "build:login": "esbuild src/login/main.ts src/login/post.ts --bundle --platform=node --target=node20 --format=cjs --outdir=login/dist --out-extension:.js=.cjs",
    "build:wait-for-optimized-image": "esbuild src/wait-for-optimized-image/main.ts src/wait-for-optimized-image/post.ts --bundle --platform=node --target=node20 --format=cjs --outdir=wait-for-optimized-image/dist --out-extension:.js=.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/vcr-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@10.30.2"
}
