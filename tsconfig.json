{
  "compilerOptions": {
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "target": "ES2022",
    "moduleResolution": "bundler",
    "module": "esnext"
  },
  "include": ["src", "test"]
}
